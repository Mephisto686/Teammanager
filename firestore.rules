rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: ist der Nutzer eingeloggt? ─────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Helper: globale Rolle aus roles/{uid} lesen ────────────────
    function globalRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }
    function isGlobalAdmin() {
      return isSignedIn() && globalRole() == "admin";
    }

    // ── Helper: Rolle des Nutzers INNERHALB einer Gruppe ───────────
    function groupRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }
    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    // Ersteller einer Gruppe (Feld createdBy im Gruppen-Dokument) – darf sein Team initial einrichten
    function isGroupCreator(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }
    // Anmeldeschluss: Ist für den Termin (Teil der Dokument-ID vor "__") eine Frist gesetzt und abgelaufen,
    // dürfen Eltern/Spieler nicht mehr zu-/absagen. Trainer/Admins sind davon ausgenommen (siehe rsvps).
    function rsvpOpen(groupId, docId) {
      let metaPath = /databases/$(database)/documents/groups/$(groupId)/eventMeta/$(docId.split('__')[0]);
      return !exists(metaPath)
        || !('deadlineMs' in get(metaPath).data)
        || request.time.toMillis() < get(metaPath).data.deadlineMs;
    }
    // Admin des Teams (Rolle "admin" im Mitgliedsdokument) oder globaler Admin
    function isGroupAdmin(groupId) {
      return isGlobalAdmin() || (isGroupMember(groupId) && groupRole(groupId) == "admin");
    }
    // Offener Beitritt: Eltern/Spieler dürfen auch ohne Code beitreten (Standard; Admin kann das im Team ausschalten: openJoin=false)
    function groupOpen(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('openJoin', true) != false;
    }
    // Gültiger Einladungscode dieses Teams (wird im Mitgliedsdokument als "joinCode" mitgeschickt).
    // Der Code muss existieren (erneuerte Codes werden gelöscht) und darf nicht abgelaufen sein (expiresAtMs, leer = unbegrenzt).
    function validJoinCode(groupId) {
      let codePath = /databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode);
      return ('joinCode' in request.resource.data)
        && exists(codePath)
        && get(codePath).data.groupId == groupId
        && (!('expiresAtMs' in get(codePath).data)
            || get(codePath).data.expiresAtMs == null
            || request.time.toMillis() < get(codePath).data.expiresAtMs);
    }
    function canWriteGroup(groupId) {
      return isGlobalAdmin() ||
        (isGroupMember(groupId) && groupRole(groupId) in ["admin","trainer"]);
    }

    // ── LEGACY: alte roles/{uid} — global ──────────────────────────
    match /roles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isGlobalAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── GRUPPEN-VERZEICHNIS ──────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if canWriteGroup(groupId);

      // Mitgliederliste der Gruppe
      // NEU: Eltern sehen nur noch ihr eigenes Mitgliedsdokument (Trainer/Admin die ganze Liste).
      match /members/{uid} {
        allow read: if isGlobalAdmin() || canWriteGroup(groupId) || (isSignedIn() && request.auth.uid == uid);
        // Selbstbeitritt nur mit den Rollen "eltern" und/oder "spieler" (Feld "roles"), nur mit diesen Feldern
        // und nur in offenen Teams oder mit gültigem Einladungscode. Trainer/Admin gibt es nur durch Bestätigung eines Admins.
        // Verknüpfte Kinder ("childIds") setzen nur Trainer/Admin bzw. die Cloud Function "claimChildren".
        // Der Ersteller eines neuen Teams legt sich selbst als "admin" an.
        allow create: if isGlobalAdmin() ||
          (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role in ["eltern","spieler"]
            && request.resource.data.keys().hasOnly(["uid","role","roles","name","email","photo","joinedAt","joinCode"])
            && (!('roles' in request.resource.data) || request.resource.data.roles.hasOnly(["eltern","spieler"]))
            && (groupOpen(groupId) || validJoinCode(groupId))) ||
          (isSignedIn() && request.auth.uid == uid && request.resource.data.role == "admin" && isGroupCreator(groupId)) ||
          isGroupAdmin(groupId);
        // Rollen ("role", "roles") ändern nur Admins. Trainer dürfen ausschließlich die Verknüpfung mit
        // Kindern/Spielerprofil ("childIds") setzen. Jeder darf im eigenen Dokument nur "name" ändern (Profil).
        allow update: if isGroupAdmin(groupId) ||
          (canWriteGroup(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childIds'])) ||
          (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
        // Löschen: Admins, sowie jeder sein eigenes Mitgliedsdokument (Team verlassen / eigenes Profil löschen)
        allow delete: if isGroupAdmin(groupId) || (isSignedIn() && request.auth.uid == uid);
      }

      // Einladungscode der Gruppe — nur für Mitglieder/Admin sichtbar
      match /settings/{docId} {
        allow read: if isGlobalAdmin() || isGroupMember(groupId);
        allow write: if canWriteGroup(groupId) || isGroupCreator(groupId);
      }

      // Beitrittswünsche (Dropdown-Weg ohne Code)
      match /joinRequests/{uid} {
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow read: if canWriteGroup(groupId) || (isSignedIn() && request.auth.uid == uid);
        allow delete: if canWriteGroup(groupId) || (isSignedIn() && request.auth.uid == uid);
        allow update: if false;
      }

      // Trainings/Kader/Turniere/Kasse/To-Dos etc. — je Kategorie ein Dokument
      // NEU: Lesen nur für Trainer/Admin. Eltern dürfen ausschließlich die reduzierten
      // Projektionen "playersPublic" (id, Name) und "eventsPublic" (Termine) lesen.
      match /shared/{col} {
        allow read: if isGlobalAdmin() || (isGroupMember(groupId) &&
          (col in ["playersPublic","eventsPublic"] || groupRole(groupId) in ["admin","trainer"]));
        // Kassenbuch: nur admin darf schreiben (spiegelt CAN.editKasse im Client)
        allow write: if col == "kassenbuch"
          ? (isGlobalAdmin() || (isGroupMember(groupId) && groupRole(groupId) == "admin"))
          : canWriteGroup(groupId);
      }

      // AKTIVITÄTSLOG – drei Stufen, je nach Sichtbarkeit. Einträge sind unveränderlich (nur anlegen).
      //  log_all:   alle Mitglieder (z. B. Termine)
      //  log_coach: nur Trainer & Admins (Trainingsplanung, Mannschaften, Kasse …)
      //  log_admin: nur Admins (reserviert)
      match /log_all/{id} {
        allow read: if isGlobalAdmin() || isGroupMember(groupId);
        allow create: if canWriteGroup(groupId);
        allow update, delete: if false;
      }
      match /log_coach/{id} {
        allow read: if canWriteGroup(groupId);
        allow create: if canWriteGroup(groupId);
        allow update, delete: if false;
      }
      match /log_admin/{id} {
        allow read: if isGlobalAdmin() || (isGroupMember(groupId) && groupRole(groupId) == "admin");
        allow create: if canWriteGroup(groupId);
        allow update, delete: if false;
      }

      // Termin-Metadaten (Anmeldeschluss): alle Mitglieder lesen, nur Trainer/Admin schreiben
      match /eventMeta/{eventKey} {
        allow read: if isGlobalAdmin() || isGroupMember(groupId);
        allow write: if canWriteGroup(groupId);
      }

      // NEU: Zu-/Absagen zu Terminen (ein Dokument je Termin+Kind: {terminKey}__{spielerId})
      // Eltern dürfen nur für Kinder schreiben, die in ihrem Mitgliedsdokument (childIds) verknüpft sind.
      match /rsvps/{docId} {
        allow read: if isGlobalAdmin() || isGroupMember(groupId);
        allow create, update: if canWriteGroup(groupId) ||
          (isGroupMember(groupId)
            && rsvpOpen(groupId, docId)
            && docId.matches('.*__' + request.resource.data.playerId)
            && request.resource.data.playerId in
               get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('childIds', []));
        allow delete: if canWriteGroup(groupId) ||
          (isGroupMember(groupId)
            && rsvpOpen(groupId, docId)
            && docId.matches('.*__' + resource.data.playerId)
            && resource.data.playerId in
               get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.get('childIds', []));
      }
    }

    // ── EINLADUNGSCODES ──────────────────────────────────────────────
    // Einzeln abrufbar (Code eingeben), aber nicht auflistbar. Anlegen, ändern (Gültigkeit) und löschen (Erneuern)
    // dürfen nur Trainer/Admin des jeweiligen Teams – bzw. der Ersteller beim Anlegen eines neuen Teams.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.groupId is string
        && (canWriteGroup(request.resource.data.groupId) || isGroupCreator(request.resource.data.groupId));
      allow update: if isSignedIn()
        && canWriteGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSignedIn() && canWriteGroup(resource.data.groupId);
    }

    // ── PRESENCE ─────────────────────────────────────────────────────
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isGlobalAdmin(); // Admin räumt beim Löschen eines Nutzers auf
    }

    // ── ACTIVITY LOG ─────────────────────────────────────────────────
    match /activity/{docId} {
      allow read: if isGlobalAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
